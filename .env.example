# ── LLM Provider: "gemini" or "openai" ───────────────────────────────────────
LLM_PROVIDER=openai

# ── Gemini config (used when LLM_PROVIDER=gemini) ────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ROUTER_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_MAIN_MODEL=gemini-2.5-flash-preview-05-20
# Legacy single-model var (used as fallback if ROUTER/MAIN not set):
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# ── OpenAI config (used when LLM_PROVIDER=openai) ────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override base URL for OpenAI-compatible providers (Groq, Cerebras, etc.)
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_ROUTER_MODEL=gpt-4.1-nano
OPENAI_MAIN_MODEL=gpt-4.1-mini

# ── API URL (used by the Streamlit frontend) ──────────────────────────────────
API_URL=http://localhost:8000

# ── Langfuse observability (optional — app works without these) ───────────────
# Sign up free at https://cloud.langfuse.com then copy your project keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
