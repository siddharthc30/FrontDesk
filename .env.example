# ── LLM Provider: "gemini" or "openai" ───────────────────────────────────────
LLM_PROVIDER=openai

# ── Gemini config (used when LLM_PROVIDER=gemini) ────────────────────────────
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_MAIN_MODEL=gemini-2.5-flash-preview-05-20
# Legacy single-model var (used as fallback if ROUTER/MAIN not set):
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# ── OpenAI config (used when LLM_PROVIDER=openai) ────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override base URL for OpenAI-compatible providers (Groq, Cerebras, etc.)
LLM_BASE_URL=
OPENAI_ROUTER_MODEL=gpt-4.1-nano
OPENAI_MAIN_MODEL=gpt-4.1-mini

# ── API URL (used by the Streamlit frontend) ──────────────────────────────────
API_URL=http://localhost:8000

# ── Langfuse observability (optional for the app; required for evals) ────────
# Sign up free at https://cloud.langfuse.com then copy your project keys.
# Used by: app tracing (@observe decorators) AND python -m evals.run_eval
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Voice: TTS (Text-to-Speech) ───────────────────────────────────────────────
# The app works fully without these — voice degrades gracefully to text-only.
#
# TTS_PROVIDER: "elevenlabs" (default) or "openai"
TTS_PROVIDER=elevenlabs

# ElevenLabs — get a free API key at https://elevenlabs.io (free tier: ~10k chars/month)
# ELEVENLABS_VOICE_ID: find voice IDs at https://elevenlabs.io/voice-lab or via the API.
#   Default: 21m00Tcm4TlvDq8ikWAM (Rachel — a clear, neutral English voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: override the ElevenLabs model (default: eleven_turbo_v2_5 — fast + cheap)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# OpenAI TTS (used when TTS_PROVIDER=openai — reuses OPENAI_API_KEY above)
# OPENAI_TTS_VOICE: alloy | echo | fable | onyx | nova | shimmer  (default: nova)
# OPENAI_TTS_MODEL: tts-1 (fast) | tts-1-hd (higher quality)  (default: tts-1)
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_MODEL=tts-1

# ── Voice: STT (Speech-to-Text) ───────────────────────────────────────────────
# Server-side transcription for the voice mic input.
# STT_PROVIDER: "openai" (default, uses Whisper — reuses OPENAI_API_KEY above)
STT_PROVIDER=openai
